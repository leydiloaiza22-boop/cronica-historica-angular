# =========================================================
# Plantilla de variables secretas.
#   1. Copie este archivo como .env      (cp .env.example .env)
#   2. Cambie los valores por unos propios
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.
# =========================================================

# Clave para firmar los tokens de sesión (mínimo 16 caracteres)
SECRET_KEY=escriba-aqui-una-clave-larga-y-aleatoria

# Contraseña del usuario de demostración demo@cronica.com
# (si se deja vacía, no se crea el usuario demo)
DEMO_PASSWORD=escriba-aqui-una-contrasena
