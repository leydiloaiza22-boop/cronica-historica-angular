# =========================================================
# Variables de Jenkins. Copie este archivo como jenkins/.env
#   (cp jenkins/.env.example jenkins/.env)  y cambie los valores.
# jenkins/.env está en .gitignore: NUNCA se sube a GitHub.
# Jenkins Configuration as Code (jenkins.yaml) las usa para crear
# el usuario administrador y las credenciales.
# =========================================================

# Usuario administrador de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=escriba-aqui-una-clave-para-jenkins

# Credenciales que usa el pipeline (mismos significados que el .env del proyecto)
CRONICA_SECRET_KEY=escriba-aqui-una-clave-larga-de-minimo-16-caracteres
CRONICA_DEMO_PASSWORD=escriba-aqui-una-contrasena-demo

# Opcional: usuario y token de GitHub de solo lectura (credencial github-cronica)
GITHUB_USUARIO=
GITHUB_TOKEN=
